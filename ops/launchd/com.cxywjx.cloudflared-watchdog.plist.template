<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>Label</key>
  <string>com.cxywjx.cloudflared-watchdog</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_EXECUTABLE__</string>
    <string>__WATCHDOG_SCRIPT__</string>
    <string>--state-path</string>
    <string>__STATE_PATH__</string>
    <string>--lock-path</string>
    <string>__LOCK_PATH__</string>
    <string>--failure-threshold</string>
    <string>2</string>
    <string>--cooldown-seconds</string>
    <string>180</string>
    <string>--recovery-timeout</string>
    <string>45</string>
    <string>--poll-interval</string>
    <string>2</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__</string>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
